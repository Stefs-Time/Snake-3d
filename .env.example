# Port the server binds to. Railway injects this automatically.
PORT=8080

# Where the JSON leaderboard lives when no database is configured.
# Point this at a Railway Volume mount path to make scores survive redeploys.
DATA_DIR=./data

# Optional. When set, the leaderboard uses Postgres instead of the JSON file.
# Railway's Postgres plugin provides this variable for you.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
